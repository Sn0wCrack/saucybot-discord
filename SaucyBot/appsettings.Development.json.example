{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Debug",
        "Microsoft.Hosting.Lifetime": "Debug",
        "Microsoft.EntityFrameworkCore": "Debug",
        "System.Net.Http.HttpClient": "Debug"
      }
    }
  },
  "Bot": {
    "ShardMode": "Automatic",
    "DiscordStatus": {
      "Enabled": true,
      "Type": "Watching",
      "Text": "your links..."
    },
    "MessageCacheSize": 10,
    "DiscordToken": "",
    "ConnectionTimeout": 120000,
    "DisabledSites": [],
    "MaximumEmbeds": 8
  },
  "Database": {
    "Disabled": false,
    "ConnectionString": "server=database;user=root;password=secret;database=bot"
  },
  "Cache": {
    "Driver": "Redis",
    "Redis": {
      "DefaultLifetime": 3600,
      "ConnectionString": "cache:6379"
    },
    "Memory": {
      "DefaultLifetime": 3600
    }
  },
  "Sites": {
    "ArtStation": {
      "PostLimit": 5
    },
    "Pixiv": {
      "Login": "",
      "Password": "",
      "SessionCookie": "",
      "PostLimit": 5,
      "Ugoira": {
        "Codec": "H264",
        "Bitrate": 2000,
        "Preset": 6,
        "CRF": 40
      }
    },
    "Twitter": {
      "ApiKey": "",
      "ApiSecret": "",
      "AccessToken": "",
      "AccessSecret": "",
      "BearerToken": "",
      "Delay": "2.00"
    },
    "ExHentai": {
      "Cookies": {
        "MemberId": "",
        "PasswordHash": ""
      }
    },
    "FxTwitter": {
      "AutoDetectLanguage": false
    },
    "DeviantArt": {
      "ClientId": 0,
      "ClientSecret": ""
    },
    "Misskey": {
      "Delay": "2.00"
    },
    "Bluesky": {
      "Delay": "2.00"
    },
    "FurAffinity": {
      "Cookies": {
        "A": "",
        "B": ""
      }
    }
  }
}
