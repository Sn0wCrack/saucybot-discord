{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "variables": [
      {
         "name": "staged-diff-files",
         "command": "git",
         "args": ["diff", "--cached", "--name-only", "--no-ext-diff", "--diff-filter=ACMRTUXB"],
         "staged": true
      }
   ],
   "tasks": [
      {
         "name": "lint",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [ "format", "--include", "${staged-diff-files}" ],
         "windows": {
            "command": "dotnet",
            "args": [ "format", "--include", "${staged-diff-files}" ]
         },
         "include": ["**/*.cs", "**/*.csproj", "**/*.slnx"]
      },
      {
         "name": "test",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [ "test", "--verbosity", "normal" ],
         "windows": {
            "command": "dotnet",
            "args": [ "test", "--verbosity", "normal" ]
         },
         "include": ["**/*.cs", "**/*.csproj", "**/*.slnx"]
      }
   ]
}
